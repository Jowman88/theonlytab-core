# Copy to .env on the VPS. Never commit the real file.
DATABASE_URL=******host:5432/database
# Production site origins, comma separated. Do NOT use *
STREAM_ALLOWED_ORIGINS=https://theonlytab.io,https://www.theonlytab.io
STREAM_MAX_CONNECTIONS_PER_IP=20
# Behind Caddy, so trust X-Forwarded-For
TRUST_PROXY_HEADERS=true
STREAM_FPS=8
STREAM_JPEG_QUALITY=40
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_DOMAIN=stream.example.com
PORT=10000
LOG_FORWARD_URL=
